[Unit]
Description=CloudSentinels Go API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudsentinels
Group=cloudsentinels
WorkingDirectory=/opt/cloudsentinels
EnvironmentFile=/etc/cloudsentinels/api.env
ExecStart=/opt/cloudsentinels/bin/cloudsentinels
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
