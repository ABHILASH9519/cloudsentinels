# Copy to .env. Never commit the populated .env file.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# AWS credentials are only needed for n8n's SQS Trigger node.
# Prefer temporary credentials from AWS IAM Identity Center / STS.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
