                                         "jsCode":  "const allowed = [\u0027schemaVersion\u0027,\u0027eventId\u0027,\u0027eventType\u0027,\u0027occurredAt\u0027,\u0027clusterId\u0027,\u0027clusterName\u0027,\u0027sourceType\u0027,\u0027environment\u0027,\u0027severity\u0027,\u0027title\u0027,\u0027summary\u0027];\nconst items = $input.all();\nconst getHeader = (headers, name) =\u003e {\n  const key = Object.keys(headers || {}).find((candidate) =\u003e candidate.toLowerCase() === name.toLowerCase());\n  return key ? headers[key] : undefined;\n};\nconst parseObject = (value, label) =\u003e {\n  if (typeof value === \u0027string\u0027) {\n    try { value = JSON.parse(value); }\n    catch { throw new Error(`Invalid ${label}: expected a JSON object`); }\n  }\n  return value \u0026\u0026 typeof value === \u0027object\u0027 \u0026\u0026 !Array.isArray(value) ? value : {};\n};\nreturn items.map((item, index) =\u003e {\n  const root = parseObject(item.json, \u0027webhook input\u0027);\n  const headers = parseObject(root.headers, \u0027webhook headers\u0027);\n  let body = root.body !== undefined ? parseObject(root.body, \u0027request body\u0027) : root;\n  // Accept common event wrappers used by API gateways and event relays.\n  for (const key of [\u0027data\u0027, \u0027detail\u0027, \u0027payload\u0027]) {\n    if ((!body.eventId || !body.eventType) \u0026\u0026 body[key] !== undefined) {\n      const nested = parseObject(body[key], key);\n      if (Object.keys(nested).length) body = nested;\n    }\n  }\n  const headerEventId = getHeader(headers, \u0027x-cs-event-id\u0027);\n  const eventId = String(body.eventId || headerEventId || \u0027\u0027).trim();\n  const eventType = String(body.eventType || \u0027\u0027).trim();\n  if (!eventId || !eventType) {\n    const keys = Object.keys(body).slice(0, 20).join(\u0027, \u0027) || \u0027(none)\u0027;\n    throw new Error(`Invalid CloudSentinels event at item ${index + 1}: eventId and eventType are required. Received keys: ${keys}. Send a JSON object with both fields.`);\n  }\n  if (eventId.length \u003e 128 || eventType.length \u003e 80) throw new Error(\u0027Rejected event: eventId or eventType exceeds the allowed length\u0027);\n  const event = {};\n  for (const key of allowed) if (body[key] !== undefined) event[key] = body[key];\n  event.eventId = eventId;\n  event.eventType = eventType;\n  event.severity = String(event.severity || \u0027info\u0027).toLowerCase();\n  const validSeverities = [\u0027critical\u0027,\u0027high\u0027,\u0027degraded\u0027,\u0027warning\u0027,\u0027medium\u0027,\u0027low\u0027,\u0027info\u0027];\n  if (!validSeverities.includes(event.severity)) event.severity = \u0027info\u0027;\n  const type = eventType.toLowerCase();\n  let route = \u0027general\u0027;\n  if (type.includes(\u0027recover\u0027) || type.includes(\u0027online\u0027) || type.includes(\u0027healthy\u0027)) route = \u0027recovery\u0027;\n  else if (event.severity === \u0027critical\u0027 || type.includes(\u0027offline\u0027) || type.includes(\u0027notready\u0027)) route = \u0027critical\u0027;\n  else if ([\u0027high\u0027,\u0027degraded\u0027,\u0027warning\u0027,\u0027medium\u0027].includes(event.severity) || type.includes(\u0027degraded\u0027) || type.includes(\u0027warning\u0027) || type.includes(\u0027crashloop\u0027)) route = \u0027degraded\u0027;\n  const safe = (value, max) =\u003e String(value || \u0027\u0027).replace(/[\\u0000-\\u001f\\u007f]/g, \u0027 \u0027).slice(0, max);\n  return { json: { ...event, title: safe(event.title || eventType, 180), summary: safe(event.summary, 1000), clusterName: safe(event.clusterName, 120), route, receivedAt: new Date().toISOString(), receiver: \u0027n8n-local\u0027, signaturePresent: Boolean(getHeader(headers, \u0027x-cs-signature\u0027) \u0026\u0026 getHeader(headers, \u0027x-cs-timestamp\u0027)), autoRemediation: false } };\n});"
