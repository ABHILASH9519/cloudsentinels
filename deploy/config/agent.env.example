CLOUDSENTINELS_API_URL=https://cloudsentinels.example.com
CLOUDSENTINELS_AGENT_CLUSTER_ID=replace-with-registered-cluster-id
CLOUDSENTINELS_AGENT_CONTEXT=replace-with-kube-context
CLOUDSENTINELS_AGENT_KUBECTL_CONTEXT=replace-with-kube-context
CLOUDSENTINELS_AGENT_TOKEN=
CLOUDSENTINELS_AGENT_SOURCE_TYPE=kubernetes-agent
CLOUDSENTINELS_AGENT_ENVIRONMENT=development
CLOUDSENTINELS_AGENT_INTERVAL=30s
CLOUDSENTINELS_AGENT_ALLOW_MUTATIONS=false
CLOUDSENTINELS_AGENT_ALLOWED_NAMESPACES=cloudsentinels-system
KUBECONFIG=/etc/cloudsentinels/agent.kubeconfig
