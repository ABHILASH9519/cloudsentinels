# CloudSentinels Go service configuration (copy to a private .env file; never commit secrets)
CLOUDSENTINELS_HTTP_ADDR=:8080
CLOUDSENTINELS_EXECUTION_MODE=online-server
CLOUDSENTINELS_ENV=development
CLOUDSENTINELS_VERSION=dev
CLOUDSENTINELS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cognito ID-token validation (configure both values together)
COGNITO_ISSUER_URL=
COGNITO_APP_CLIENT_ID=

# Local user auth for development only (minimum 32 chars).
CLOUDSENTINELS_LOCAL_AUTH_TOKEN=
CLOUDSENTINELS_ALLOW_LOCAL_AUTH_IN_PROD=false

# Airtable server-side access. Do not expose this PAT in VITE_* variables.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=app3xn3iXAsm7MgA7
AIRTABLE_SNAPSHOT_PATH=deploy/eks/airtable-inventory.snapshot.json
AIRTABLE_SYNC_INTERVAL=5m

# Zapier outbound Catch Hook + inbound HMAC verification. Use separate strong secrets.
ZAPIER_CATCH_HOOK_URL=
ZAPIER_SIGNING_SECRET=

# Optional authenticated agent-to-AWS Lambda event forwarding (HTTPS URL + 32+ character HMAC secret).
CLOUDSENTINELS_LAMBDA_TELEMETRY_URL=
CLOUDSENTINELS_LAMBDA_SIGNING_SECRET=

# Desktop agent shared secret; configure the same value on the Go API and local agent.
CLOUDSENTINELS_AGENT_TOKEN=
# Optional per-cluster credentials JSON, e.g. {"recClusterId":"<32+ character token>"}
CLOUDSENTINELS_AGENT_TOKENS={}
CLOUDSENTINELS_AGENT_ALLOW_MUTATIONS=false
