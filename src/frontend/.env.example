# Browser-visible Clerk publishable key. This is public by design.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_development_publishable_key

# Server-only Clerk and ICP gateway configuration.
# Never prefix these values with VITE_ and never commit real values.
CLERK_SECRET_KEY=sk_test_replace_in_your_secret_manager
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://your-preview-domain.vercel.app
ICP_BACKEND_CANISTER_ID=replace_with_real_backend_canister_id
ICP_GATEWAY_IDENTITY_SECRET=replace_with_a_random_secret_of_at_least_32_characters
ICP_HOST=https://icp-api.io
