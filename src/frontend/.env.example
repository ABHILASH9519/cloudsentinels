# Public Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Hosted AWS API Gateway base URL, including the deployed stage (for example /v1)
VITE_AWS_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/v1
VITE_AWS_REGION=ap-south-1

# Local Go API base URL (use the hosted Go API URL when one is deployed)
VITE_CLOUDSENTINELS_API_URL=http://127.0.0.1:8082
