# Public browser configuration only — never put server-side secrets here.
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_COGNITO_DOMAIN=https://your-prefix.auth.ap-south-1.amazoncognito.com
VITE_AWS_API_URL=https://example.execute-api.ap-south-1.amazonaws.com/v1

# CloudSentinels Go API. Local dev: http://127.0.0.1:8080
# Production deployments must use an HTTPS API endpoint.
VITE_CLOUDSENTINELS_API_URL=http://127.0.0.1:8080
