# Public Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local Go API base URL (use the hosted Go API URL when one is deployed)
VITE_CLOUDSENTINELS_API_URL=http://127.0.0.1:8082

# Explicitly enable only for the loopback Compose dashboard.
VITE_LOCAL_OPERATOR=false
